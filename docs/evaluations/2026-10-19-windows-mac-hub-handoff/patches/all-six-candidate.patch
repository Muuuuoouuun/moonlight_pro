+'use strict';
+// Executes the JS Unix-socket protocol on Linux/macOS with an in-memory cookie
+// double. It does not exercise Electron, native login, Keychain, or Swift.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises');
+const net = require('node:net');
+const { EventEmitter } = require('node:events');
+const { startHubSessionBridge } = require('./hub-session-bridge');
+
+const origin = 'https://hub.example.test';
+const cookieName = 'com_moon_operator_session';
+const originalSession = { value: 'previous.signature', expiresAt: Date.now() / 1000 + 3600 };
+const nextSession = { value: 'renewed.signature', expiresAt: originalSession.expiresAt };
+const socketOptions = { skip: process.platform === 'win32', timeout: 5000 };
+
+function deferred() {
+  let resolve;
+  const promise = new Promise((done) => { resolve = done; });
+  return { promise, resolve };
+}
+
+function exchange(socketPath, value = { action: 'read', origin }) {
+  return new Promise((resolve, reject) => {
+    const socket = net.createConnection(socketPath);
+    let body = '';
+    socket.on('connect', () => socket.write(`${JSON.stringify(value)}\n`));
+    socket.on('data', (chunk) => { body += chunk; });
+    socket.on('end', () => {
+      try { resolve(JSON.parse(body)); } catch (error) { reject(error); }
+    });
+    socket.on('error', reject);
+  });
+}
+
+async function createBridge(t) {
+  const directory = await fs.mkdtemp('/tmp/moonlight-session-snapshot-');
+  const cookies = new EventEmitter();
+  let current;
+  const replace = (value) => {
+    current = value ? { name: cookieName, value: value.value, expirationDate: value.expiresAt,
+      domain: 'hub.example.test', path: '/' } : null;
+  };
+  replace(originalSession);
+  cookies.get = async () => current ? [current] : [];
+  cookies.set = async (value) => replace({ value: value.value, expiresAt: value.expirationDate });
+  cookies.remove = async () => replace(null);
+  cookies.flushStore = async () => {};
+  const changed = (value, cause = 'explicit', name = cookieName, domain = 'hub.example.test') => {
+    if (name === cookieName && domain === 'hub.example.test') replace(value);
+    cookies.emit('changed', {}, { name, domain, path: '/' }, cause, value === null);
+  };
+  const bridge = await startHubSessionBridge({ directory, session: { cookies }, getHubUrl: () => origin });
+  t.after(() => bridge.close()); // Retain the isolated temporary directory; no recursive removal.
+  return { bridge, cookies, changed };
+}
+
+async function holdFirstRead(cookies) {
+  const read = cookies.get;
+  const began = deferred(), release = deferred();
+  let reads = 0;
+  cookies.get = async (...args) => {
+    reads++;
+    const snapshot = await read(...args);
+    if (reads === 1) { began.resolve(); await release.promise; }
+    return snapshot;
+  };
+  return { began: began.promise, release: release.resolve, reads: () => reads };
+}
+
+test('session snapshot discards a prior cookie when logout arrives during lookup', socketOptions, async (t) => {
+  const { bridge, cookies, changed } = await createBridge(t);
+  const gate = await holdFirstRead(cookies);
+  const pending = exchange(bridge.socketPath);
+  await gate.began;
+  changed(null);
+  gate.release();
+  assert.deepEqual(await pending, { origin, session: null, signedOut: true });
+  const login = await exchange(bridge.socketPath, { action: 'write', origin, session: nextSession });
+  assert.deepEqual(login, { origin, session: nextSession, signedOut: false });
+});
+
+test('session snapshot rereads after logout then login instead of exporting the older cookie', socketOptions, async (t) => {
+  const { bridge, cookies, changed } = await createBridge(t);
+  const gate = await holdFirstRead(cookies);
+  const pending = exchange(bridge.socketPath);
+  await gate.began;
+  changed(null);
+  changed(nextSession);
+  gate.release();
+  assert.deepEqual(await pending, { origin, session: nextSession, signedOut: false });
+  assert.equal(gate.reads(), 2);
+});
+
+test('session snapshot preserves natural expiry without inventing explicit logout', socketOptions, async (t) => {
+  const { bridge, cookies, changed } = await createBridge(t);
+  const gate = await holdFirstRead(cookies);
+  const pending = exchange(bridge.socketPath);
+  await gate.began;
+  changed(null, 'expired');
+  gate.release();
+  assert.deepEqual(await pending, { origin, session: null, signedOut: false });
+  assert.equal(gate.reads(), 2);
+});
+
+test('session snapshot bounds repeated rotation and recovers on the next stable read', socketOptions, async (t) => {
+  const { bridge, cookies, changed } = await createBridge(t);
+  const read = cookies.get;
+  let reads = 0;
+  cookies.get = async (...args) => {
+    reads++;
+    const snapshot = await read(...args);
+    changed(reads === 1 ? nextSession : originalSession);
+    return snapshot;
+  };
+  assert.deepEqual(await exchange(bridge.socketPath), { error: 'rejected' });
+  assert.equal(reads, 2);
+  cookies.get = read;
+  assert.deepEqual(await exchange(bridge.socketPath), { origin, session: originalSession, signedOut: false });
+});
+
+test('session snapshot observes a concurrent bridge write even without a cookie event', socketOptions, async (t) => {
+  const { bridge, cookies } = await createBridge(t);
+  const gate = await holdFirstRead(cookies);
+  const pending = exchange(bridge.socketPath);
+  await gate.began;
+  assert.deepEqual(await exchange(bridge.socketPath, { action: 'write', origin, session: nextSession }),
+    { origin, session: nextSession, signedOut: false });
+  gate.release();
+  assert.deepEqual(await pending, { origin, session: nextSession, signedOut: false });
+});
+
+test('session snapshot ignores unrelated cookie changes', socketOptions, async (t) => {
+  const { bridge, cookies, changed } = await createBridge(t);
+  const gate = await holdFirstRead(cookies);
+  const pending = exchange(bridge.socketPath);
+  await gate.began;
+  changed(null, 'explicit', 'unrelated_cookie');
+  changed(null, 'explicit', cookieName, 'other.example.test');
+  gate.release();
+  assert.deepEqual(await pending, { origin, session: originalSession, signedOut: false });
+  assert.equal(gate.reads(), 1);
+});
+
+test('session snapshots begun before or during a pending login reject until the cookie write settles', socketOptions, async (t) => {
+  const { bridge, cookies } = await createBridge(t);
+  const readGate = await holdFirstRead(cookies);
+  const earlierRead = exchange(bridge.socketPath);
+  await readGate.began;
+  const set = cookies.set;
+  const beganSet = deferred(), releaseSet = deferred();
+  cookies.set = async (...args) => { beganSet.resolve(); await releaseSet.promise; await set(...args); };
+  const writing = exchange(bridge.socketPath, { action: 'write', origin, session: nextSession });
+  await beganSet.promise;
+  const duringRead = await exchange(bridge.socketPath);
+  readGate.release();
+  const earlierResponse = await earlierRead;
+  releaseSet.resolve();
+  assert.deepEqual(await writing, { origin, session: nextSession, signedOut: false });
+  assert.deepEqual(duringRead, { error: 'rejected' });
+  assert.deepEqual(earlierResponse, { error: 'rejected' });
+  assert.deepEqual(await exchange(bridge.socketPath), { origin, session: nextSession, signedOut: false });
+});
+
+test('session snapshot retains all overlapping write reservations and clears failed writes', socketOptions, async (t) => {
+  const { bridge, cookies } = await createBridge(t);
+  const set = cookies.set;
+  const beganSet = deferred(), releaseSet = deferred();
+  let writes = 0;
+  cookies.set = async (...args) => {
+    writes++;
+    if (writes === 1) { beganSet.resolve(); await releaseSet.promise; throw new Error('Isolated write failure'); }
+    await set(...args);
+  };
+  const firstWrite = exchange(bridge.socketPath, { action: 'write', origin, session: originalSession });
+  await beganSet.promise;
+  const secondWrite = await exchange(bridge.socketPath, { action: 'write', origin, session: nextSession });
+  const duringRead = await exchange(bridge.socketPath);
+  releaseSet.resolve();
+  assert.deepEqual(await firstWrite, { error: 'rejected' });
+  assert.deepEqual(secondWrite, { error: 'rejected' });
+  assert.deepEqual(duringRead, { error: 'rejected' });
+  assert.deepEqual(await exchange(bridge.socketPath), { origin, session: nextSession, signedOut: false });
+});
diff --git a/apps/desktop/pet/main/pet-hub-cancellation.test.js b/apps/desktop/pet/main/pet-hub-cancellation.test.js
new file mode 100644
index 00000000..4292e034
--- /dev/null
+++ b/apps/desktop/pet/main/pet-hub-cancellation.test.js
@@ -0,0 +1,157 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createPetHub } = require('./pet-hub');
+
+const origin = 'https://hub.example.test';
+const question = { ownerId: 'eevee', scope: 'personal', message: '준비를 기다리던 질문' };
+function deferred() {
+  let resolve;
+  const promise = new Promise(done => { resolve = done; });
+  return { promise, resolve };
+}
+const tick = () => new Promise(resolve => setImmediate(resolve));
+function response(body, answer = '확인한 답변') {
+  return new Response(JSON.stringify({ status: 'generated', version: '2026-09-22.v3',
+    ownerId: body.ownerId, scope: body.scope, mode: 'chat', lens: null, simulation: false,
+    participants: [], answer, nextAction: '검토하기', context: { source: 'provided', scope: body.scope, projects: [], note: '입력 기준' },
+    log: { persisted: false, runId: null }, businessWrites: false }));
+}
+function harness(t, { holdReplies = false } = {}) {
+  const ready = deferred();
+  const calls = [], replies = [], events = [];
+  const hub = createPetHub({ origin,
+    store: { get: async key => { if (key === `petHub.pending.v1.${origin}`) await ready.promise; return null; }, set: async () => {} },
+    onEvent: (name, payload) => events.push({ name, payload }),
+    fetch: async (url, init) => {
+      const body = init.body ? JSON.parse(init.body) : null;
+      calls.push({ url, method: init.method, body, signal: init.signal });
+      if (init.method !== 'POST') return new Response(JSON.stringify({ status: 'anonymous', configured: true }));
+      if (!holdReplies) return response(body);
+      const gate = deferred(); replies.push({ gate, body });
+      return gate.promise;
+    },
+  });
+  t.after(() => { ready.resolve(); for (const entry of replies) entry.gate.resolve(response(entry.body)); hub.dispose(); });
+  return { hub, ready, calls, replies, events };
+}
+const posts = calls => calls.filter(call => call.method === 'POST');
+
+test('cancel during connection preparation invalidates the queued send before any POST', async t => {
+  const { hub, ready, calls } = harness(t);
+  const pending = hub.chatSend(question);
+  const cancelled = await hub.chatCancel();
+  ready.resolve();
+  const result = await pending;
+  assert.deepEqual({ cancelled: cancelled.data.cancelled, error: result.error, posts: posts(calls).length },
+    { cancelled: true, error: 'cancelled', posts: 0 });
+});
+
+test('repeated cancel is idempotent and an explicit replacement send may start before preparation completes', async t => {
+  const { hub, ready, calls } = harness(t);
+  const old = hub.chatSend(question);
+  const first = await hub.chatCancel();
+  const repeated = await hub.chatCancel();
+  const newer = hub.chatSend({ ...question, message: '명시적으로 다시 보낸 질문' });
+  ready.resolve();
+  const [oldResult, newResult] = await Promise.all([old, newer]);
+  assert.equal(first.data.cancelled, true);
+  assert.equal(repeated.data.cancelled, false);
+  assert.equal(oldResult.error, 'cancelled');
+  assert.equal(newResult.kind, 'live');
+  assert.deepEqual(posts(calls).map(call => call.body.message), ['명시적으로 다시 보낸 질문']);
+  assert.equal((await hub.chatCancel()).data.cancelled, false);
+});
+
+test('one send reservation covers preparation as well as the network request', async t => {
+  const { hub, ready, calls } = harness(t);
+  const first = hub.chatSend(question);
+  let duplicate;
+  const second = hub.chatSend({ ...question, message: '중복 클릭' }).then(value => { duplicate = value; return value; });
+  await tick();
+  const rejectedBeforeReady = duplicate?.error;
+  ready.resolve();
+  await Promise.all([first, second]);
+  assert.equal(rejectedBeforeReady, 'busy');
+  assert.equal(posts(calls).length, 1);
+});
+
+test('an old queued completion cannot clear or cancel the newer in-flight request', async t => {
+  const { hub, ready, calls, replies } = harness(t, { holdReplies: true });
+  const old = hub.chatSend(question);
+  await hub.chatCancel();
+  const newer = hub.chatSend({ ...question, message: '새로 보낸 질문' });
+  ready.resolve();
+  await tick();
+  // Release all transport gates so the pre-fix reproduction cannot hang.
+  const oldRace = await Promise.race([old, Promise.resolve(null)]);
+  const state = await hub.chatSession(question);
+  const duplicate = hub.chatSend({ ...question, message: '진행 중 중복' });
+  const cancelled = await hub.chatCancel();
+  for (const entry of replies) entry.gate.resolve(response(entry.body, '늦은 답변'));
+  const [oldResult, newResult, duplicateResult] = await Promise.all([old, newer, duplicate]);
+  assert.equal(oldRace?.error, 'cancelled');
+  assert.equal(oldResult.error, 'cancelled');
+  assert.equal(state.data.busyWith.message, '새로 보낸 질문');
+  assert.equal(duplicateResult.error, 'busy');
+  assert.equal(cancelled.data.cancelled, true);
+  assert.equal(newResult.error, 'cancelled');
+  assert.deepEqual(posts(calls).map(call => call.body.message), ['새로 보낸 질문']);
+  assert.deepEqual((await hub.chatSession(question)).data.turns, []);
+});
+
+test('origin replacement releases old preparation reservation without waiting for old storage', async t => {
+  const { hub, ready, calls } = harness(t);
+  const old = hub.chatSend(question);
+  await hub.setOrigin('https://replacement.example.test');
+  const newer = await hub.chatSend({ ...question, message: '새 허브 질문' });
+  ready.resolve();
+  assert.equal((await old).error, 'stale-origin');
+  assert.equal(newer.kind, 'live');
+  assert.deepEqual(posts(calls).map(call => new URL(call.url).origin), ['https://replacement.example.test']);
+});
+
+test('same-origin session replacement invalidates the old reservation and admits an explicit new send', async t => {
+  const { hub, ready, calls } = harness(t);
+  const old = hub.chatSend(question);
+  const changed = hub.sessionChanged();
+  const newer = hub.chatSend({ ...question, message: '새 세션 질문' });
+  ready.resolve();
+  const [oldResult, newResult] = await Promise.all([old, newer, changed]);
+  assert.equal(oldResult.error, 'stale-origin');
+  assert.equal(newResult.kind, 'live');
+  assert.deepEqual(posts(calls).map(call => call.body.message), ['새 세션 질문']);
+});
+
+test('dispose invalidates queued sends and leaves no cancellable reservation', async t => {
+  const { hub, ready, calls } = harness(t);
+  const old = hub.chatSend(question);
+  hub.dispose();
+  const cancelled = await hub.chatCancel();
+  ready.resolve();
+  assert.equal((await old).error, 'stale-origin');
+  assert.equal(cancelled.data.cancelled, false);
+  assert.equal(posts(calls).length, 0);
+});
+
+test('in-flight cancellation keeps abort behavior and ignores a late reply after a new send', async t => {
+  const { hub, ready, calls, replies, events } = harness(t, { holdReplies: true });
+  ready.resolve();
+  const old = hub.chatSend(question);
+  await tick();
+  const cancelled = await hub.chatCancel();
+  const newer = hub.chatSend({ ...question, message: '취소 후 새 질문' });
+  await tick();
+  replies[0].gate.resolve(response(replies[0].body, '취소된 늦은 답'));
+  const oldResult = await old;
+  const busy = (await hub.chatSession(question)).data.busy;
+  replies[1].gate.resolve(response(replies[1].body, '새 요청의 답'));
+  const newerResult = await newer;
+  assert.equal(cancelled.data.cancelled, true);
+  assert.equal(posts(calls)[0].signal.aborted, true);
+  assert.equal(oldResult.error, 'cancelled');
+  assert.equal(busy, true);
+  assert.equal(newerResult.data.turn.text, '새 요청의 답');
+  assert.deepEqual(events.filter(entry => entry.name === 'pet:chat-reply').map(entry => entry.payload.turn.text), ['새 요청의 답']);
+  assert.deepEqual((await hub.chatSession(question)).data.turns.map(turn => turn.text), ['취소 후 새 질문', '새 요청의 답']);
+});
