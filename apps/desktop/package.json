{
  "name": "@com-moon/desktop",
  "productName": "Moonlight",
  "version": "0.1.0",
  "private": true,
  "description": "Moonlight 허브를 여는 데스크톱 셸 (Windows·macOS)",
  "author": "Moonlight",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac --arm64",
    "install:mac": "node scripts/install-mac.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "app.moonlight.hub",
    "productName": "Moonlight",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "hub-url.js",
      "widget-window.js",
      "widget-preload.js",
      "menu-template.js",
      "pet/**",
      "!pet/**/*.test.js",
      "!pet/**/test-support/**",
      "!pet/renderer/README.md",
      "app.config.json",
      "settings/**",
      "package.json",
      {
        "from": "build",
        "to": "assets",
        "filter": ["trayTemplate.png", "trayTemplate@2x.png"]
      },
      {
        "from": "../hub/public",
        "to": "assets",
        "filter": ["icon-192.png"]
      },
      {
        "from": "../hub/public/fonts",
        "to": "pet/fonts",
        "filter": ["SUIT-Variable.woff2", "JetBrainsMono-Variable.woff2"]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-",
      "electronLanguages": ["ko", "en"],
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "artifactName": "Moonlight-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Moonlight ${version}",
      "contents": [
        { "x": 140, "y": 190 },
        { "x": 400, "y": 190, "type": "link", "path": "/Applications" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Moonlight-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Moonlight-Portable-${version}.${ext}"
    }
  }
}
