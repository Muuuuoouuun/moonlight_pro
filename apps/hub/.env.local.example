# Hub local-only overrides
# Copy to `.env.local` and fill real values when needed.

NEXT_PUBLIC_APP_URL=http://localhost:3000
COM_MOON_HUB_URL=http://localhost:3000
COM_MOON_ENGINE_URL=http://localhost:3001

# Supabase client config
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase server config
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional legacy alias for older server helpers
# SUPABASE_ANON_KEY=your-anon-key

COM_MOON_DEFAULT_WORKSPACE_ID=11111111-1111-1111-1111-111111111111
COM_MOON_OPERATOR_EMAIL=junhyuk.mun@classin.com
COM_MOON_OPERATOR_ALIAS=junhyuk
COM_MOON_SHARED_WEBHOOK_SECRET=your-shared-webhook-secret
COM_MOON_HUB_WRITE_SECRET=your-hub-write-secret
# Optional HMAC key for HttpOnly operator session cookies. Falls back to the
# Hub write secret when omitted.
COM_MOON_OPERATOR_SESSION_SECRET=your-operator-session-secret
# ClassIn operator goals used by Revenue ledger + Guru context.
COM_MOON_CLASSIN_BASELINE_CONTRACTS=6
COM_MOON_CLASSIN_BASELINE_REVENUE_CNY=100000
COM_MOON_CLASSIN_MONTHLY_CONTRACT_TARGET=60
COM_MOON_CLASSIN_MONTHLY_UNIT_TARGET=60
COM_MOON_CLASSIN_MONTHLY_REVENUE_TARGET_CNY=300000
COM_MOON_CLASSIN_AVG_HARDWARE_CNY=20000
COM_MOON_CLASSIN_SOFTWARE_FIRST_RECHARGE_CNY=10000
# Required for Google OAuth state payloads. Falls back to the shared webhook
# secret when omitted.
COM_MOON_OAUTH_STATE_SECRET=your-oauth-state-secret

# Optional GitHub wiring for PMS / roadmap surfaces
# GITHUB_TOKEN=your-github-token
# GITHUB_REPOSITORIES=Muuuuoouuun/moonlight_pro
# GITHUB_PROJECT_MAP=Muuuuoouuun/moonlight_pro=33333333-3333-3333-3333-333333333331

# Optional AI wiring proxied through Engine
# GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# AI_DEFAULT_PROVIDER=gemini
# AI_DEFAULT_MODEL=gemini-3.5-flash
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional CRM intake wiring. Sheets/Gmail guards only accept
# COM_MOON_OPERATOR_EMAIL, and Sheets only accepts this personal lead sheet.
# GOOGLE_SHEETS_REFRESH_TOKEN=your-google-sheets-refresh-token
# GOOGLE_SHEETS_SPREADSHEET_ID=your-personal-leads-spreadsheet-id
# COM_MOON_PERSONAL_LEADS_SPREADSHEET_ID=your-personal-leads-spreadsheet-id
# EEOCRM_OWNER_ID=3935704427463307
# EEOCRM_MCP_URL=http://localhost:3010/sse

# Optional Meta Threads OAuth for Classmooni / moon.classin
# COM_MOON_META_THREADS_APP_ID=your-threads-app-id
# COM_MOON_META_THREADS_APP_SECRET=your-threads-app-secret
# COM_MOON_META_THREADS_BRAND_HANDLE=moon.classin
# COM_MOON_META_THREADS_SCOPES=threads_basic,threads_content_publish

# Optional Instagram API with Instagram Login for Classmooni / moon.classin
# COM_MOON_INSTAGRAM_APP_ID=your-instagram-app-id
# COM_MOON_INSTAGRAM_APP_SECRET=your-instagram-app-secret
# COM_MOON_INSTAGRAM_BRAND_HANDLE=moon.classin
# COM_MOON_INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
