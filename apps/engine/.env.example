# Current Engine env contract.
# Planned connector secrets and rollout order are documented in docs/integration-inventory.md.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key
COM_MOON_DEFAULT_WORKSPACE_ID=your-workspace-uuid
DEFAULT_WORKSPACE_ID=your-workspace-uuid
# Shared secret for Engine write routes. When set, project webhooks and email send
# require x-com-moon-shared-secret or Authorization: Bearer.
COM_MOON_SHARED_WEBHOOK_SECRET=your-shared-webhook-secret
# Keep false unless you are running unauthenticated local smoke tests.
COM_MOON_ALLOW_OPEN_WEBHOOKS=false
# Registered landing form servers only; [] leaves inquiry intake disabled.
# Entries: {id,token,workspaceId,orgScope,formIds}. Never expose tokens to browser bundles.
# See docs/inquiry-integration-setup.md.
COM_MOON_INQUIRY_SOURCES=[]
# Galaxy phone capture (POST /api/intake/phone-events). Separate from the shared secret so a lost
# phone only opens this one route. Sent as x-com-moon-phone-secret or Authorization: Bearer.
# Empty leaves phone intake disabled (503). See docs/guides/galaxy-phone-capture.md.
COM_MOON_PHONE_INTAKE_SECRET=
# Research briefs and non-council weekly reports have a separate quality model.
# Chat/customer/council flows continue using their existing model settings.
COM_MOON_CONTENT_QUALITY_MODEL=gemini-3.1-pro-preview

# Vertex Cloud route: uses the linked Cloud billing account (see docs/guides/vertex-cloud-credit.md).
# Keep developer until both local ADC / production federation are ready.
GEMINI_BACKEND=developer
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Local ADC only. Never deploy a user's ADC JSON to Vercel.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/application_default_credentials.json
# Vercel production uses OIDC; configure the following in both Hub and Engine.
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
