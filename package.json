{
  "name": "moonlight",
  "private": true,
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/hub",
    "apps/engine",
    "apps/desktop",
    "packages/*",
    "apps/android"
  ],
  "scripts": {
    "icons:generate": "node ./scripts/generate-brand-icons.mjs",
    "guidance:sources": "node ./scripts/build-guidance-source-library.mjs",
    "check:guidance-sources": "node ./scripts/build-guidance-source-library.mjs --check",
    "build": "turbo run build",
    "check:contracts": "node ./scripts/check-contracts.mjs",
    "check:connections": "node ./scripts/check-connections.mjs",
    "check:sheets": "node ./scripts/check-sheets-normalize.mjs",
    "check:cards": "node ./scripts/check-card-intake.mjs",
    "check:personas": "node ./scripts/check-persona-registry.mjs",
    "check:context": "node ./scripts/check-context-assembler.mjs",
    "check:inbox": "node ./scripts/check-inbox-router.mjs",
    "check:scoring": "node ./scripts/check-followup-scoring.mjs",
    "check:classin": "npm run check:sheets && npm run check:context && npm run check:scoring && npm run check:inbox && npm run check:personas",
    "crm:fill": "node ./scripts/fill-crm-intake.mjs",
    "db:migrate": "node ./scripts/apply-migrations.mjs",
    "check:runtime": "node ./scripts/check-runtime.mjs",
    "db:check": "node ./scripts/check-database-readiness.mjs",
    "db:usage": "node ./scripts/db-usage-report.mjs",
    "db:move-region": "node ./scripts/migrate-supabase-region.mjs",
    "dev:sandbox": "cd apps/hub && set -a && . ./.env.sandbox.local && set +a && NEXT_DIST_DIR=.next.sandbox npx next dev -p 3020",
    "db:seed-dev": "set -a && . ./.env.migration.local && set +a && psql --dbname \"$MOONLIGHT_DEV_DB_URL\" -X -q --set ON_ERROR_STOP=1 -f supabase/seed.dev.sql",
    "dev": "turbo run dev",
    "dev:hub": "npm --workspace @com-moon/hub run dev",
    "dev:engine": "npm --workspace @com-moon/engine run dev",
    "app:win:dev": "npm --workspace @com-moon/desktop run dev",
    "app:win:build": "npm --workspace @com-moon/desktop run build",
    "app:mac:dev": "npm --workspace @com-moon/desktop run dev",
    "app:mac:build": "npm --workspace @com-moon/desktop run build:mac",
    "app:mac:install": "npm --workspace @com-moon/desktop run install:mac --",
    "inventory:project-connections": "node ./scripts/inventory-project-connections.mjs",
    "test": "node --import ./scripts/register-hub-alias.mjs --test --test-concurrency=2 scripts/*.test.mjs apps/hub/lib/*.test.mjs apps/hub/lib/**/*.test.mjs \"apps/hub/app/**/*.test.mjs\" \"apps/hub/components/**/*.test.mjs\" \"apps/engine/**/*.test.mjs\" \"packages/**/*.test.mjs\"",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "mcp:doctor": "node --env-file-if-exists=apps/hub/.env.local packages/mcp-server/src/doctor.js",
    "mcp:connect": "node packages/mcp-server/src/connect.js",
    "mcp:http": "node packages/mcp-server/bin/moonlight-mcp.js --http",
    "codex:worker": "node --env-file-if-exists=.env.codex-worker.local packages/codex-worker/cli.mjs",
    "codex:check": "node --env-file-if-exists=.env.codex-worker.local packages/codex-worker/cli.mjs --check",
    "app:android:sync": "npm --workspace @com-moon/android run config:sync --",
    "app:android:build": "npm --workspace @com-moon/android run apk --"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
